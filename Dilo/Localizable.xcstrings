    },
    "Elígelo otra vez para reintentar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick it again to retry."
          }
        }
      }
    },
    "Empezar a dictar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
