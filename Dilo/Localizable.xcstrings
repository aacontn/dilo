{
  "sourceLanguage": "es",
  "strings": {
    "%@ Vacío, Dilo lo busca donde lo deja el instalador y en tu shell.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Leave it empty and Dilo looks where the installer puts it and in your shell."
          }
        }
      }
    },
    "%@ en los últimos 14 días": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in the last 14 days"
          }
        }
      }
    },
    "%@ no terminó de bajar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not finish downloading"
          }
        }
      }
    },
    "%@ ocupa %lld MB y ya no se usa. Va a la Papelera: si quieres volver, lo sacas de ahí.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ takes up %2$lld MB and isn't used anymore. It goes to the Trash: if you want to go back, take it out of there."
          }
        }
      }
    },
    "%@ palabras dictadas": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ words dictated"
          }
        }
      }
    },
    "%@ palabras dictadas en total": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ words dictated in total"
