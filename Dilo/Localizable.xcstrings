        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phonon 40m is by Gradium and is used under its CC BY-NC 4.0 license: personal, non-commercial use. The voices are Apache 2.0. They're downloaded separately and don't ship inside Dilo."
