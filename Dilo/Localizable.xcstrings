    "No cabe: a la derecha ya va %@ y la izquierda también está ocupada. Apaga uno de los dos para ver este.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doesn't fit: %@ is already on the right and the left side is taken too. Turn one of them off to see this one."
          }
        }
      }
    },
