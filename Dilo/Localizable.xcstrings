        }
      }
    },
    "%@ palabras en los últimos 14 días": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ words over the last 14 days"
          }
        }
      }
    },
    "%@ se equivoca menos y es igual de rápido. Son %lld MB; mientras bajan, sigues dictando como hoy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ makes fewer mistakes and is just as fast. It's %2$lld MB; while it downloads, you keep dictating as usual."
          }
        }
      }
    },
    "%@ se está bajando": {
      "extractionState": "manual",
