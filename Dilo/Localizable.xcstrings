      }
    },
    "Mantén %@ para hablar y pegar la traducción. Elige antes el idioma en Idioma.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ to speak and paste a translation. Pick the language in Language first."
          }
        }
      }
    },
    "Mantén %@ y habla; suéltala y listo. Un toque corto la deja trabada y otro toque termina.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
