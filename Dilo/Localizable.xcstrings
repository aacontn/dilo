    },
    "El micrófono no entregó sonido. Revisa su permiso o elige otro en Ajustes → Dictado.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone gave no sound. Check its permission or pick another in Settings → Dictation."
