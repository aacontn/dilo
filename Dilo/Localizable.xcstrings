      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the meeting and build its script"
          }
        }
      }
    },
    "Grabar una reunión": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a meeting"
          }
        }
      }
    },
    "Grabar una reunión: tu micrófono y el audio del Mac, cada uno en su pista": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a meeting: your microphone and the Mac's audio, each on its own track"
          }
        }
      }
    },
    "Ya hay una reunión grabando.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meeting is already recording."
          }
        }
      }
    },
    "Queda muy poco disco para grabar (%lld MB). Libera al menos 1 GB.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's too little disk space to record (%lld MB). Free up at least 1 GB."
          }
        }
      }
    },
    "No pude crear la carpeta de la reunión: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't create the meeting's folder: %@"
          }
        }
      }
    },
    "No pude abrir ni el micrófono ni el audio del Mac: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't open the microphone or the Mac's audio: %@"
          }
        }
