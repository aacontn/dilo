    "Tu micrófono y el audio del Mac, cada uno en su pista. Puedes cerrar esta ventana: la reunión sigue grabando.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your microphone and the Mac's audio, each on its own track. You can close this window: the meeting keeps recording."
          }
        }
      }
    },
