        }
      }
    },
    "Mantén %@ para dictar en tu otro idioma, o tócala igual que la principal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ to dictate in your other language, or tap it like the main one."
