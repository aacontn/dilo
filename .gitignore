# Sparkle: an exported private signing key must never be committed. The key
# normally stays in the login Keychain; setup-sparkle-keys.sh --export writes
# this file only when you are backing it up.
sparkle-private-key.txt
sparkle_eddsa_private_key

# An empty file some tool drops in the repo root; it has no business here
# and a wide "git add" keeps catching it.
.oss

# El `Package.resolved` que deja `swift test` dentro de DiloCore. El que manda
# es el del `.xcodeproj`; tener dos es tener dos que se contradicen.
DiloCore/Package.resolved
